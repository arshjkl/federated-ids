# Database
DATABASE_URL=sqlite+aiosqlite:///./federated_ids.db
DB_ECHO=false

# Application
APP_HOST=0.0.0.0
APP_PORT=18003
DEBUG=false
CORS_ORIGINS=*

# Model paths (read-only existing models)
CENTRALIZED_MODEL_PATH=models/centralized_mlp.pth
IMPROVED_MODEL_PATH=models/centralized_mlp_improved.pth
FEDERATED_MANUAL_PATH=models/federated_mlp_manual.pth
DP_FEDERATED_PATH=models/federated_mlp_dp.pth

# Preprocessing artifacts (read-only)
SCALER_PATH=data/processed/scaler.pkl
FEATURE_NAMES_PATH=data/processed/feature_names.json
LABEL_MAPPING_PATH=data/processed/label_mapping.json

# Artifact directories (writable)
GLOBAL_MODELS_DIR=artifacts/global_models
SIMULATION_CHECKPOINTS_DIR=artifacts/simulation_checkpoints
UPLOADED_DATASETS_DIR=artifacts/uploaded_datasets
INFERENCE_RESULTS_DIR=artifacts/inference_results